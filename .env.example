# Token de EODHD. Crea una cuenta en https://eodhd.com/register y pega aquí tu token.
# Si lo dejas como "demo", el servidor arranca en modo demostración y solo
# responde con los símbolos públicos de EODHD: AAPL.US, AMZN.US, TSLA.US, VTI.US.
EODHD_API_TOKEN=demo

# Puerto del servidor (web + API)
PORT=3000

# Opcional: cambia la URL del proveedor (pruebas locales o proxy propio)
# EODHD_BASE_URL=https://eodhd.com/api

# Opcional: tiempo máximo de espera por petición al proveedor, en milisegundos
# UPSTREAM_TIMEOUT_MS=9000

# Opcional: contacto para SEC EDGAR (movimientos de directivos, gratis y sin token).
# La SEC exige un User-Agent con un correo real; sin él puede devolver 403.
# SEC_USER_AGENT="MOAT screener (contacto: tu-correo@tudominio.com)"

# Opcional: carpeta donde se guardan las copias de seguridad con código (por defecto .data/)
# MOAT_DATA_DIR=./.data
