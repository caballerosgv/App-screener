{
  "name": "app-screener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Base para empaquetar app web como app Android con Capacitor",
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "build": "rm -rf dist && mkdir -p dist && cp -R public/. dist/",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^5.5.4"
  }
}
